diff --git a/app/src/main/java/org/thoughtcrime/securesms/util/VesperConfig.kt b/app/src/main/java/org/thoughtcrime/securesms/util/VesperConfig.kt
new file mode 100644
index 0000000000..b992683286
--- /dev/null
+++ b/app/src/main/java/org/thoughtcrime/securesms/util/VesperConfig.kt
@@ -0,0 +1,237 @@
+/*
+ * Copyright 2026 Vesper contributors
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.util
+
+import androidx.annotation.VisibleForTesting
+import androidx.annotation.WorkerThread
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonNull
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.booleanOrNull
+import kotlinx.serialization.json.doubleOrNull
+import kotlinx.serialization.json.int
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.longOrNull
+import okhttp3.Request
+import org.signal.core.models.ServiceId.ACI
+import org.signal.core.util.logging.Log
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.keyvalue.SignalStore
+import org.thoughtcrime.securesms.recipients.hashVesperAci
+import java.io.IOException
+import kotlin.time.Duration.Companion.days
+
+object VesperConfig {
+  private val TAG = Log.tag(VesperConfig::class.java)
+
+  private const val CONFIG_ORIGIN = "https://vsp.asy.st"
+  private const val SCHEMA_VERSION = 1
+  private val REFRESH_INTERVAL = 1.days
+  private val ACI_HASH_PATTERN = Regex("^[0-9a-f]{64}$")
+  private val FLAG_NAME_PATTERN = Regex("^[A-Za-z][A-Za-z0-9._-]{0,127}$")
+
+  data class Response(
+    val schemaVersion: Int,
+    val developerAciHashes: Set<String>,
+    val flagOverrides: Map<String, Any?>
+  )
+
+  sealed interface FlagOverrideResult {
+    data object Missing : FlagOverrideResult
+    data class Present(val value: Any?) : FlagOverrideResult
+  }
+
+  private val emptyResponse = Response(
+    schemaVersion = SCHEMA_VERSION,
+    developerAciHashes = emptySet(),
+    flagOverrides = emptyMap()
+  )
+
+  @Volatile
+  private var response: Response = emptyResponse
+
+  @JvmStatic
+  fun init() {
+    val cached = SignalStore.vesperConfig.cachedConfig
+    response = if (cached == null) {
+      emptyResponse
+    } else {
+      try {
+        parse(cached)
+      } catch (e: IllegalArgumentException) {
+        Log.w(TAG, "Ignoring invalid cached Vesper config.", e)
+        emptyResponse
+      }
+    }
+  }
+
+  @JvmStatic
+  @WorkerThread
+  fun refreshIfNecessary(isInternalUser: Boolean) {
+    val aci = SignalStore.account.aci ?: return
+    val now = System.currentTimeMillis()
+    if (!shouldRefresh(isInternalUser, SignalStore.vesperConfig.lastFetchTime, now)) {
+      return
+    }
+
+    try {
+      refreshSync(aci, now)
+    } catch (e: IOException) {
+      Log.w(TAG, "Unable to refresh Vesper config.", e)
+    } catch (e: IllegalArgumentException) {
+      Log.w(TAG, "Ignoring invalid Vesper config response.", e)
+    }
+  }
+
+  @WorkerThread
+  @Throws(IOException::class, IllegalArgumentException::class)
+  private fun refreshSync(aci: ACI, now: Long) {
+    val request = Request.Builder()
+      .url("$CONFIG_ORIGIN/config/${hashVesperAci(aci)}")
+      .apply {
+        SignalStore.vesperConfig.eTag
+          .takeIf(String::isNotEmpty)
+          ?.let { header("If-None-Match", it) }
+      }
+      .build()
+
+    AppDependencies.okHttpClient.newCall(request).execute().use { networkResponse ->
+      if (networkResponse.code == 304) {
+        SignalStore.vesperConfig.lastFetchTime = now
+        return
+      }
+      if (!networkResponse.isSuccessful) {
+        throw IOException("Vesper config request failed with ${networkResponse.code}")
+      }
+
+      val body = networkResponse.body.string()
+      val parsed = parse(body)
+      val eTag = networkResponse.header("ETag")
+        ?: throw IOException("Vesper config response is missing an ETag")
+
+      SignalStore.vesperConfig.cachedConfig = body
+      SignalStore.vesperConfig.eTag = eTag
+      SignalStore.vesperConfig.lastFetchTime = now
+      response = parsed
+    }
+  }
+
+  fun isDeveloperAciHash(hash: String): Boolean {
+    return hash in response.developerAciHashes
+  }
+
+  fun flagOverride(name: String): FlagOverrideResult {
+    val overrides = response.flagOverrides
+    return if (name in overrides) {
+      FlagOverrideResult.Present(overrides[name])
+    } else {
+      FlagOverrideResult.Missing
+    }
+  }
+
+  fun valueWithOverride(name: String, fallback: Any?): Any? {
+    return when (val override = flagOverride(name)) {
+      FlagOverrideResult.Missing -> fallback
+      is FlagOverrideResult.Present -> override.value
+    }
+  }
+
+  fun applyOverrides(values: Map<String, Any>): Map<String, Any> {
+    val result = values.toMutableMap()
+    for ((name, value) in response.flagOverrides) {
+      if (value == null) {
+        result.remove(name)
+      } else {
+        result[name] = value.toRemoteConfigValue()
+      }
+    }
+    return result
+  }
+
+  private fun Any.toRemoteConfigValue(): Any {
+    return if (this is Number) toString() else this
+  }
+
+  @VisibleForTesting
+  internal fun shouldRefresh(
+    isInternalUser: Boolean,
+    lastFetchTime: Long,
+    now: Long
+  ): Boolean {
+    if (isInternalUser || lastFetchTime <= 0) {
+      return true
+    }
+    val elapsed = now - lastFetchTime
+    return elapsed < 0 || elapsed >= REFRESH_INTERVAL.inWholeMilliseconds
+  }
+
+  @VisibleForTesting
+  internal fun parse(raw: String): Response {
+    val root = Json.parseToJsonElement(raw).jsonObject
+    require(root.getValue("schemaVersion").jsonPrimitive.int == SCHEMA_VERSION) {
+      "Unsupported Vesper config schema"
+    }
+
+    val developerHashesJson = root.getValue("developerAciHashes").jsonArray
+    val developerHashes = buildSet {
+      for (element in developerHashesJson) {
+        val hash = element.jsonPrimitive.content
+        require(ACI_HASH_PATTERN.matches(hash)) {
+          "Invalid Vesper developer ACI hash"
+        }
+        add(hash)
+      }
+    }
+
+    val overridesJson = root.getValue("flagOverrides").jsonArray
+    val overrides = linkedMapOf<String, Any?>()
+    for (element in overridesJson) {
+      val item = element.jsonObject
+      val name = item.getValue("name").jsonPrimitive.content
+      require(FLAG_NAME_PATTERN.matches(name)) {
+        "Invalid Vesper config flag name"
+      }
+      require(name !in overrides) {
+        "Duplicate Vesper config flag override"
+      }
+
+      val rawValue = item.getValue("value")
+      val value = when (rawValue) {
+        JsonNull -> null
+        is JsonPrimitive -> when {
+          rawValue.isString -> rawValue.content
+          rawValue.booleanOrNull != null -> rawValue.booleanOrNull
+          rawValue.longOrNull != null -> {
+            val number = rawValue.longOrNull!!
+            if (number in Int.MIN_VALUE..Int.MAX_VALUE) number.toInt() else number
+          }
+          rawValue.doubleOrNull != null -> rawValue.doubleOrNull
+          else -> throw IllegalArgumentException("Invalid Vesper config flag value")
+        }
+        else -> throw IllegalArgumentException("Invalid Vesper config flag value")
+      }
+      overrides[name] = value
+    }
+
+    return Response(
+      schemaVersion = SCHEMA_VERSION,
+      developerAciHashes = developerHashes,
+      flagOverrides = overrides
+    )
+  }
+
+  @VisibleForTesting
+  internal fun activateForTest(next: Response) {
+    response = next
+  }
+
+  @VisibleForTesting
+  internal fun resetForTest() {
+    response = emptyResponse
+  }
+}
