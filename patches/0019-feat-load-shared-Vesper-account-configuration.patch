+ */
+
+package org.thoughtcrime.securesms.util
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertThrows
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.signal.core.models.ServiceId.ACI
+import org.thoughtcrime.securesms.recipients.hashVesperAci
+import kotlin.time.Duration.Companion.days
+
+class VesperConfigTest {
+  private val aci = ACI.parseOrThrow("00000000-0000-4000-8000-000000000001")
+  private val aciHash = "11e594f481958c10e3015d0bf0447a22f068a8a647f475df15ce2c7ab4b8f3f1"
+
+  @Before
+  fun setUp() {
+    VesperConfig.resetForTest()
+  }
+
+  @Test
+  fun `hashes the canonical lowercase ACI`() {
+    assertEquals(aciHash, hashVesperAci(aci))
+  }
+
+  @Test
+  fun `parses developer hashes and typed flag overrides`() {
+    val parsed = VesperConfig.parse(
+      """
+      {
+        "schemaVersion": 1,
+        "developerAciHashes": ["$aciHash"],
+        "flagOverrides": [
+          {"name": "android.internalUser", "value": true},
+          {"name": "global.pinnedChatLimit", "value": 8},
+          {"name": "vesper.example", "value": null}
+        ]
+      }
+      """.trimIndent()
+    )
+
+    assertEquals(setOf(aciHash), parsed.developerAciHashes)
+    assertEquals(true, parsed.flagOverrides["android.internalUser"])
+    assertEquals(8, parsed.flagOverrides["global.pinnedChatLimit"])
+    assertTrue(parsed.flagOverrides.containsKey("vesper.example"))
+    assertEquals(null, parsed.flagOverrides["vesper.example"])
+  }
+
+  @Test
+  fun `rejects malformed developer hashes`() {
+    assertThrows(IllegalArgumentException::class.java) {
+      VesperConfig.parse(
+        """
+        {
+          "schemaVersion": 1,
+          "developerAciHashes": ["not-a-hash"],
+          "flagOverrides": []
+        }
+        """.trimIndent()
+      )
+    }
+  }
+
+  @Test
+  fun `refreshes every internal startup and otherwise after one day`() {
+    val now = 2.days.inWholeMilliseconds
+
+    assertTrue(VesperConfig.shouldRefresh(true, now, now))
+    assertFalse(VesperConfig.shouldRefresh(false, now - 1.days.inWholeMilliseconds + 1, now))
+    assertTrue(VesperConfig.shouldRefresh(false, now - 1.days.inWholeMilliseconds, now))
+  }
+
+  @Test
+  fun `applies cached overrides without mutating the base config`() {
+    val base = mapOf(
+      "android.internalUser" to false,
+      "global.pinnedChatLimit" to "4",
+      "vesper.remove" to true
+    )
+    VesperConfig.activateForTest(
+      VesperConfig.Response(
+        schemaVersion = 1,
+        developerAciHashes = emptySet(),
+        flagOverrides = mapOf(
+          "android.internalUser" to true,
+          "global.pinnedChatLimit" to 8,
+          "vesper.remove" to null
+        )
+      )
+    )
+
+    assertEquals(
+      mapOf(
+        "android.internalUser" to true,
+        "global.pinnedChatLimit" to "8"
+      ),
+      VesperConfig.applyOverrides(base)
+    )
+    assertEquals("4", base["global.pinnedChatLimit"])
