@@ -0,0 +1,27 @@
+/*
+ * Copyright 2026 Vesper contributors
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.keyvalue
+
+class VesperConfigValues(store: KeyValueStore) : SignalStoreValues(store) {
+  companion object {
+    private const val CACHED_CONFIG = "vesper_config.cached"
+    private const val ETAG = "vesper_config.etag"
+    private const val LAST_FETCH_TIME = "vesper_config.last_fetch_time"
+  }
+
+  public override fun onFirstEverAppLaunch() = Unit
+  public override fun getKeysToIncludeInBackup(): List<String> = emptyList()
+
+  var cachedConfig: String?
+    get() = getString(CACHED_CONFIG, null)
+    set(value) = putString(CACHED_CONFIG, value)
+
+  var eTag: String
+    get() = getString(ETAG, "")
+    set(value) = putString(ETAG, value)
+
+  var lastFetchTime: Long by longValue(LAST_FETCH_TIME, 0)
+}
