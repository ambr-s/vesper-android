+++ b/app/src/test/java/org/thoughtcrime/securesms/keyvalue/VesperSettingsValuesTest.kt
@@ -46,6 +46,21 @@ class VesperSettingsValuesTest {
     assertTrue(settings.isIgnoreRemoteDeleteEnabled)
   }
 
+  @Test
+  fun `account configuration store retains defaults and persisted values`() {
+    val values = SignalStore.vesperConfig
+    assertEquals("", values.eTag)
+    assertEquals(null, values.cachedConfig)
+    assertEquals(0L, values.lastFetchTime)
+    values.eTag = "cache-validator"
+    values.cachedConfig = "cached-response"
+    values.lastFetchTime = 42L
+    assertEquals("cache-validator", values.eTag)
+    assertEquals("cached-response", values.cachedConfig)
+    assertEquals(42L, values.lastFetchTime)
+    assertTrue(values.keysToIncludeInBackup.isEmpty())
+  }
+
   @Test
   fun `downstream settings retain stable backup keys`() {
     val keys = SignalStore.settings.keysToIncludeInBackup
