+package org.thoughtcrime.securesms.components.settings.app.help
+
+import android.app.Application
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import org.signal.core.util.logging.Log
+import org.thoughtcrime.securesms.database.LogDatabase
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.util.RemoteConfig
+import org.thoughtcrime.securesms.util.VesperLogPreferences
+
+class HelpSettingsViewModel : ViewModel() {
+
+  private val application: Application = AppDependencies.application
+  private val internalState = MutableStateFlow(getState())
+
+  val state: StateFlow<HelpSettingsState> = internalState
+
+  fun setLogEnabled(enabled: Boolean) {
+    VesperLogPreferences.setLogEnabled(application, enabled)
+    Log.setLogging(enabled)
+
+    if (!enabled) {
+      viewModelScope.launch(Dispatchers.IO) {
+        Log.blockUntilAllWritesFinished()
+        LogDatabase.getInstance(application).run {
+          logs.clearAll()
+          crashes.clear()
+          anrs.clear()
+        }
+      }
+    }
+
+    internalState.update { getState() }
+  }
+
+  fun toggleInternalUser(): Boolean {
+    val enabled = !RemoteConfig.internalUser
+    RemoteConfig.setInternalUserOverride(enabled)
+    return enabled
+  }
+
+  private fun getState(): HelpSettingsState {
+    return HelpSettingsState(
+      logEnabled = VesperLogPreferences.isLogEnabled(application)
+    )
+  }
+}
