@@ -0,0 +1,38 @@
+package org.thoughtcrime.securesms.messages
+
+import org.thoughtcrime.securesms.database.model.ReactionRecord
+import org.thoughtcrime.securesms.recipients.RecipientId
+
+/**
+ * Stores a local-only annotation for a message whose remote-deletion request was
+ * deliberately ignored. The reactions table gives the annotation the lifecycle
+ * of its message without changing the message payload.
+ */
+object PreservedRemoteDelete {
+  private const val MARKER = "\uF8FFvesper.remote-delete"
+
+  @JvmStatic
+  fun marker(author: RecipientId): ReactionRecord {
+    return ReactionRecord(
+      emoji = MARKER,
+      author = author,
+      dateSent = 0,
+      dateReceived = 0
+    )
+  }
+
+  @JvmStatic
+  fun isMarker(reaction: ReactionRecord): Boolean {
+    return reaction.emoji == MARKER && reaction.dateSent == 0L && reaction.dateReceived == 0L
+  }
+
+  @JvmStatic
+  fun hasMarker(reactions: List<ReactionRecord>): Boolean {
+    return reactions.any(::isMarker)
+  }
+
+  @JvmStatic
+  fun hasUserReactions(reactions: List<ReactionRecord>): Boolean {
+    return reactions.any { !isMarker(it) }
+  }
+}
