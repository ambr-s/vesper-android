diff --git a/app/src/test/java/org/thoughtcrime/securesms/util/RemoteConfigOverrideTest.kt b/app/src/test/java/org/thoughtcrime/securesms/util/RemoteConfigOverrideTest.kt
index a3f839c646..1c2c211904 100644
--- a/app/src/test/java/org/thoughtcrime/securesms/util/RemoteConfigOverrideTest.kt
+++ b/app/src/test/java/org/thoughtcrime/securesms/util/RemoteConfigOverrideTest.kt
@@ -130,6 +130,28 @@ class RemoteConfigOverrideTest {
     assertThat(SignalStore.remoteConfig.overrides).isEqualTo(overrides)
   }
 
+  @Test
+  fun `Vesper policy follows upstream resolution without changing diagnostic reads`() {
+    setServiceValues(INTERNAL_USER to true, INT_FLAG to 4)
+    SignalStore.remoteConfig.overrides = mapOf(INT_FLAG to "9")
+    VesperConfig.activateForTest(VesperConfig.Response(emptySet(), mapOf(INT_FLAG to 12)))
+    RemoteConfig.init()
+
+    assertThat(RemoteConfig.pinnedChatLimit).isEqualTo(12)
+    assertThat(RemoteConfig.overridableConfigs.getValue(INT_FLAG).resolve()).isEqualTo(9)
+    assertThat(RemoteConfig.overridableConfigs.getValue(INT_FLAG).resolveDefault()).isEqualTo(4)
+  }
+
+  @Test
+  fun `Vesper libsignal overrides do not mutate upstream remote values`() {
+    setServiceValues("android.libsignal.test" to "service")
+    VesperConfig.activateForTest(VesperConfig.Response(emptySet(), mapOf("android.libsignal.test" to "vesper")))
+    RemoteConfig.init()
+
+    assertThat(RemoteConfig.libsignalConfigs["test"]).isEqualTo("vesper")
+    assertThat(RemoteConfig.REMOTE_VALUES["android.libsignal.test"]).isEqualTo("service")
+  }
+
   private fun setServiceValues(vararg values: Pair<String, Any>) {
     val json = JSONObject()
     values.forEach { (key, value) -> json.put(key, value) }
@@ -137,6 +159,7 @@ class RemoteConfigOverrideTest {
   }
 
   private fun reset() {
+    VesperConfig.resetForTest()
     RemoteConfig.overrides = emptyMap()
     RemoteConfig.REMOTE_VALUES.clear()
     RemoteConfig.initialized = false
