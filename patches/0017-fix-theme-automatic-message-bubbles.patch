diff --git a/app/src/main/java/org/thoughtcrime/securesms/conversation/colors/ChatColorsPalette.kt b/app/src/main/java/org/thoughtcrime/securesms/conversation/colors/ChatColorsPalette.kt
index 6f62d279c1..4be41efed6 100644
--- a/app/src/main/java/org/thoughtcrime/securesms/conversation/colors/ChatColorsPalette.kt
+++ b/app/src/main/java/org/thoughtcrime/securesms/conversation/colors/ChatColorsPalette.kt
@@ -1,5 +1,9 @@
 package org.thoughtcrime.securesms.conversation.colors
 
+import android.content.Context
+import androidx.core.content.ContextCompat
+import org.thoughtcrime.securesms.util.DynamicTheme
+
 /**
  * Namespaced collection of supported bubble colors and name colors.
  */
@@ -162,6 +166,21 @@ object ChatColorsPalette {
     @JvmStatic
     val default = ULTRAMARINE
 
+    /**
+     * The automatic bubble color to use when there is no wallpaper to derive one from.
+     *
+     * The light dynamic primary is intentionally used in both UI modes because outgoing
+     * message foregrounds are designed for a dark, white-compatible custom color.
+     */
+    fun automatic(context: Context): ChatColors {
+      return if (DynamicTheme.useDynamicColors(context)) {
+        val dynamicPrimary = ContextCompat.getColor(context, org.signal.core.ui.R.color.dynamic_primary_light)
+        ChatColors.forColor(ChatColors.Id.Auto, dynamicPrimary)
+      } else {
+        default.withId(ChatColors.Id.Auto)
+      }
+    }
+
     /*
      * If updating this list of colors, make sure to update the backup import/export colors as well.
      */
