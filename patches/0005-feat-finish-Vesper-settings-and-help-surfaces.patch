+internal fun shouldUpdate(
+  currentVersionCode: Int,
+  currentBuildTimestamp: Long,
+  availableVersionCode: Int,
+  availableBuildTimestamp: Long?
+): Boolean {
+  return availableVersionCode > currentVersionCode ||
+    (
+      availableVersionCode == currentVersionCode &&
+        availableBuildTimestamp != null &&
+        availableBuildTimestamp > currentBuildTimestamp
+      )
+}
