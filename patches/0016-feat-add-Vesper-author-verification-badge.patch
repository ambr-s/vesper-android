@@ -0,0 +1,30 @@
+/*
+ * Copyright 2026 Vesper contributors
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.recipients
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.signal.core.models.ServiceId.ACI
+
+class VesperVerifiedRecipientsTest {
+
+  @Test
+  fun `configured author ACIs are Vesper verified`() {
+    assertTrue(vesperAuthorACIs.isNotEmpty())
+    vesperAuthorACIs.forEach { aci ->
+      assertTrue(VesperVerifiedRecipients.contains(aci))
+    }
+  }
+
+  @Test
+  fun `other ACIs and missing ACIs are not Vesper verified`() {
+    val otherAci = ACI.parseOrThrow("00000000-0000-4000-8000-000000000001")
+
+    assertFalse(VesperVerifiedRecipients.contains(otherAci))
+    assertFalse(VesperVerifiedRecipients.contains(null))
+  }
+}
