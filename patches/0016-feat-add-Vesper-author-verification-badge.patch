+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.recipients
+
+import org.signal.core.models.ServiceId.ACI
+
+/**
+ * Recipients whose names receive Vesper's verified badge treatment.
+ *
+ * This is deliberately separate from Signal's official-account state so these
+ * recipients retain normal profile, safety-number, and conversation behavior.
+ */
+internal object VesperVerifiedRecipients {
+  fun contains(aci: ACI?): Boolean {
+    return aci != null && aci in vesperAuthorACIs
+  }
+}
