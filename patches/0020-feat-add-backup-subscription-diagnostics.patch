+/*
+ * Copyright 2026 Vesper contributors
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.components.settings.app.internal.backup.subscription
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class BackupSubscriptionDiagnosticsStateTest {
+
+  @Test
+  fun `healthy requires paid local entitlement subscriber and active server subscription`() {
+    val state = state(
+      backupsEnabled = true,
+      paidTier = true,
+      hasSubscriber = true,
+      serverCheckComplete = true,
+      serverSubscriptionActive = true
+    )
+
+    assertEquals(BackupSubscriptionHealth.HEALTHY, state.health)
+  }
+
+  @Test
+  fun `unknown server state remains checking rather than claiming success`() {
+    val state = state(
+      backupsEnabled = true,
+      paidTier = true,
+      hasSubscriber = true,
+      serverCheckComplete = false,
+      serverSubscriptionActive = null
+    )
+
+    assertEquals(BackupSubscriptionHealth.CHECKING, state.health)
+  }
+
+  @Test
+  fun `inactive server subscription requires attention`() {
+    val state = state(
+      backupsEnabled = true,
+      paidTier = true,
+      hasSubscriber = true,
+      serverCheckComplete = true,
+      serverSubscriptionActive = false
+    )
+
+    assertEquals(BackupSubscriptionHealth.ATTENTION, state.health)
+  }
+
+  @Test
+  fun `report contains useful booleans but no subscription secrets`() {
+    val report = state(
+      backupsEnabled = true,
+      paidTier = true,
+      hasSubscriber = true,
+      subscriptionType = "Google Play Billing",
+      hasPurchaseToken = true,
+      serverCheckComplete = true,
+      serverSubscriptionActive = true
+    ).toRedactedReport()
+
+    assertTrue(report.contains("Subscriber record: present"))
+    assertTrue(report.contains("Purchase token: present (redacted)"))
+    assertTrue(report.contains("Server subscription: active"))
+    assertFalse(report.contains("subscriber-id-value"))
+    assertFalse(report.contains("purchase-token-value"))
+  }
+
+  private fun state(
+    backupsEnabled: Boolean = false,
+    paidTier: Boolean = false,
+    hasSubscriber: Boolean = false,
+    subscriptionType: String = "None",
+    hasPurchaseToken: Boolean = false,
+    serverCheckComplete: Boolean = false,
+    serverSubscriptionActive: Boolean? = null
+  ): BackupSubscriptionDiagnosticsState {
+    return BackupSubscriptionDiagnosticsState(
+      backupsEnabled = backupsEnabled,
+      backupTier = if (paidTier) "PAID" else "FREE",
+      paidTier = paidTier,
+      playBillingSupported = false,
+      postRegistrationRelinkEnabled = false,
+      hasSubscriber = hasSubscriber,
+      subscriptionType = subscriptionType,
+      hasPurchaseToken = hasPurchaseToken,
+      lastKeepAliveLaunchMillis = 0,
+      lastCheckInMillis = 0,
+      lastBackupMillis = 0,
+      subscriptionMismatch = false,
+      latestPaymentState = "None",
+      latestRedemptionStage = "None",
+      latestPaymentError = "None",
+      pendingRedemption = false,
+      serverCheckComplete = serverCheckComplete,
+      serverSubscriptionActive = serverSubscriptionActive,
+      serverSubscriptionStatus = "Not checked",
+      serverRenewalEpochSeconds = null,
+      serverWillCancel = null,
+      actionInProgress = null,
+      actionMessage = null
+    )
+  }
+}
