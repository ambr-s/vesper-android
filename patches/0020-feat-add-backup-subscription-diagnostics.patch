+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.components.settings.app.internal.backup.subscription
+
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.lazy.LazyColumn
+import androidx.compose.material3.LinearProgressIndicator
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import org.signal.core.ui.compose.DayNightPreviews
+import org.signal.core.ui.compose.Previews
+import org.signal.core.ui.compose.Rows
+import org.signal.core.ui.compose.Scaffolds
+import org.signal.core.ui.compose.SignalIcons
+import org.signal.core.ui.compose.Texts
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+import java.util.concurrent.TimeUnit
+
+@Composable
+fun BackupSubscriptionDiagnosticsScreen(
+  state: BackupSubscriptionDiagnosticsState,
+  callbacks: BackupSubscriptionDiagnosticsCallbacks
+) {
+  Scaffolds.Settings(
+    title = "Backup subscription",
+    onNavigationClick = callbacks::onNavigationClick,
+    navigationIcon = SignalIcons.ArrowStart.imageVector
+  ) { paddingValues ->
+    LazyColumn(modifier = Modifier.padding(paddingValues)) {
+      if (state.actionInProgress != null) {
+        item { LinearProgressIndicator() }
+      }
+
+      item { Texts.SectionHeader(text = "Overall") }
+      item {
+        Rows.TextRow(
+          text = when (state.health) {
+            BackupSubscriptionHealth.HEALTHY -> "Healthy"
+            BackupSubscriptionHealth.CHECKING -> "Checking"
+            BackupSubscriptionHealth.ATTENTION -> "Needs attention"
+          },
+          label = when (state.health) {
+            BackupSubscriptionHealth.HEALTHY -> "Paid entitlement, restored subscriber record and active Signal subscription confirmed."
+            BackupSubscriptionHealth.CHECKING -> "Local state is present. Waiting for Signal's subscription service."
+            BackupSubscriptionHealth.ATTENTION -> "One or more required subscription signals are missing or inactive."
+          }
+        )
+      }
+      state.actionMessage?.let { message ->
+        item { Rows.TextRow(text = "Last action", label = message) }
+      }
+
+      item { Texts.SectionHeader(text = "Local state") }
+      item { Rows.TextRow(text = "Backups enabled", label = state.backupsEnabled.yesNo()) }
+      item { Rows.TextRow(text = "Backup tier", label = state.backupTier) }
+      item { Rows.TextRow(text = "Subscriber record", label = if (state.hasSubscriber) "Present" else "Missing") }
+      item { Rows.TextRow(text = "Subscription source", label = state.subscriptionType) }
+      item { Rows.TextRow(text = "Purchase token", label = if (state.hasPurchaseToken) "Present (redacted)" else "Missing") }
+      item { Rows.TextRow(text = "Play Billing available to Vesper", label = state.playBillingSupported.yesNo()) }
+      item { Rows.TextRow(text = "Initial Play relink", label = if (state.postRegistrationRelinkEnabled) "Enabled" else "Disabled") }
+      item { Rows.TextRow(text = "Subscription mismatch flag", label = state.subscriptionMismatch.yesNo()) }
+      item { Rows.TextRow(text = "Pending redemption", label = state.pendingRedemption.yesNo()) }
+
+      item { Texts.SectionHeader(text = "Signal service") }
+      item {
+        Rows.TextRow(
+          text = "Server subscription",
+          label = when {
+            !state.serverCheckComplete -> "Checking"
+            state.serverSubscriptionActive == true -> "Active"
+            state.serverSubscriptionActive == false -> "Inactive"
+            else -> "Unknown"
+          }
+        )
+      }
+      item { Rows.TextRow(text = "Server status", label = state.serverSubscriptionStatus) }
+      item { Rows.TextRow(text = "Will cancel", label = state.serverWillCancel?.yesNo() ?: "Unknown") }
+      item { Rows.TextRow(text = "Renews / expires", label = formatEpochSeconds(state.serverRenewalEpochSeconds)) }
+
+      item { Texts.SectionHeader(text = "Maintenance") }
+      item { Rows.TextRow(text = "Last keepalive launch", label = formatMillis(state.lastKeepAliveLaunchMillis)) }
+      item { Rows.TextRow(text = "Last backup check-in", label = formatMillis(state.lastCheckInMillis)) }
+      item { Rows.TextRow(text = "Last completed backup", label = formatMillis(state.lastBackupMillis)) }
+      item { Rows.TextRow(text = "Latest payment state", label = state.latestPaymentState) }
+      item { Rows.TextRow(text = "Latest redemption stage", label = state.latestRedemptionStage) }
+      item { Rows.TextRow(text = "Latest payment error", label = state.latestPaymentError) }
+
+      item { Texts.SectionHeader(text = "Manual actions") }
+      item {
+        Rows.TextRow(
+          text = "Refresh status",
+          label = "Reload local state and query Signal's subscription service without Google Play Billing.",
+          onClick = callbacks::onRefreshStatus
+        )
+      }
+      item {
+        Rows.TextRow(
+          text = "Run backup keepalive",
+          label = "Queue only the BACKUP keepalive job and update its launch timestamp.",
+          onClick = callbacks::onRunKeepAlive
+        )
+      }
+      item {
+        Rows.TextRow(
+          text = "Run backup check-in",
+          label = "Tell Signal that this remote backup is still in use.",
+          onClick = callbacks::onRunBackupCheckIn
+        )
+      }
+      item {
+        Rows.TextRow(
+          text = "Run backup now",
+          label = "Queue a remote message and media backup.",
+          onClick = callbacks::onRunBackupNow
+        )
+      }
+      item {
+        Rows.TextRow(
+          text = "Refresh backup credentials",
+          label = "Clear cached archive credentials and fetch the server tier without downgrading local state on failure.",
+          onClick = callbacks::onRefreshBackupCredentials
+        )
+      }
+      item {
+        Rows.TextRow(
+          text = "Copy redacted diagnostics",
+          label = "Copies this status without subscriber IDs or purchase-token contents.",
+          onClick = callbacks::onCopyDiagnostics
+        )
+      }
+    }
+  }
+}
+
+private fun Boolean.yesNo(): String = if (this) "Yes" else "No"
+
+private fun formatMillis(value: Long): String {
+  return if (value <= 0) "Never" else formatDate(value)
+}
+
+private fun formatEpochSeconds(value: Long?): String {
+  return if (value == null || value <= 0) "Unknown" else formatDate(TimeUnit.SECONDS.toMillis(value))
+}
+
+private fun formatDate(value: Long): String {
+  return SimpleDateFormat("yyyy-MM-dd HH:mm:ss z", Locale.US).format(Date(value))
+}
+
+interface BackupSubscriptionDiagnosticsCallbacks {
+  fun onNavigationClick() = Unit
+  fun onRefreshStatus() = Unit
+  fun onRunKeepAlive() = Unit
+  fun onRunBackupCheckIn() = Unit
+  fun onRunBackupNow() = Unit
+  fun onRefreshBackupCredentials() = Unit
+  fun onCopyDiagnostics() = Unit
+
+  object Empty : BackupSubscriptionDiagnosticsCallbacks
+}
+
+@DayNightPreviews
+@Composable
+private fun BackupSubscriptionDiagnosticsScreenPreview() {
+  Previews.Preview {
+    BackupSubscriptionDiagnosticsScreen(
+      state = BackupSubscriptionDiagnosticsState.initial().copy(
+        backupsEnabled = true,
+        backupTier = "PAID",
+        paidTier = true,
+        hasSubscriber = true,
+        subscriptionType = "Google Play Billing",
+        hasPurchaseToken = true,
+        serverCheckComplete = true,
+        serverSubscriptionActive = true,
+        serverSubscriptionStatus = "ACTIVE"
+      ),
+      callbacks = BackupSubscriptionDiagnosticsCallbacks.Empty
+    )
+  }
+}
