+/*
+ * Copyright 2026 Vesper contributors
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.components.settings.app.internal.backup.subscription
+
+enum class BackupSubscriptionHealth {
+  CHECKING,
+  HEALTHY,
+  ATTENTION
+}
+
+data class BackupSubscriptionDiagnosticsState(
+  val backupsEnabled: Boolean,
+  val backupTier: String,
+  val paidTier: Boolean,
+  val playBillingSupported: Boolean,
+  val postRegistrationRelinkEnabled: Boolean,
+  val hasSubscriber: Boolean,
+  val subscriptionType: String,
+  val hasPurchaseToken: Boolean,
+  val lastKeepAliveLaunchMillis: Long,
+  val lastCheckInMillis: Long,
+  val lastBackupMillis: Long,
+  val subscriptionMismatch: Boolean,
+  val latestPaymentState: String,
+  val latestRedemptionStage: String,
+  val latestPaymentError: String,
+  val pendingRedemption: Boolean,
+  val serverCheckComplete: Boolean,
+  val serverSubscriptionActive: Boolean?,
+  val serverSubscriptionStatus: String,
+  val serverRenewalEpochSeconds: Long?,
+  val serverWillCancel: Boolean?,
+  val actionInProgress: String?,
+  val actionMessage: String?
+) {
+  val health: BackupSubscriptionHealth
+    get() = when {
+      !backupsEnabled || !paidTier || !hasSubscriber -> BackupSubscriptionHealth.ATTENTION
+      !serverCheckComplete -> BackupSubscriptionHealth.CHECKING
+      serverSubscriptionActive == true -> BackupSubscriptionHealth.HEALTHY
+      else -> BackupSubscriptionHealth.ATTENTION
+    }
+
+  fun toRedactedReport(): String {
+    return buildString {
+      appendLine("Vesper backup subscription diagnostics")
+      appendLine("Overall: $health")
+      appendLine("Backups enabled: $backupsEnabled")
+      appendLine("Backup tier: $backupTier")
+      appendLine("Play Billing supported: $playBillingSupported")
+      appendLine("Post-registration Play relink: ${if (postRegistrationRelinkEnabled) "enabled" else "disabled"}")
+      appendLine("Subscriber record: ${if (hasSubscriber) "present" else "missing"}")
+      appendLine("Subscription type: $subscriptionType")
+      appendLine("Purchase token: ${if (hasPurchaseToken) "present (redacted)" else "missing"}")
+      appendLine("Last keepalive launch (ms): $lastKeepAliveLaunchMillis")
+      appendLine("Last backup check-in (ms): $lastCheckInMillis")
+      appendLine("Last completed backup (ms): $lastBackupMillis")
+      appendLine("Subscription mismatch: $subscriptionMismatch")
+      appendLine("Latest payment state: $latestPaymentState")
+      appendLine("Latest redemption stage: $latestRedemptionStage")
+      appendLine("Latest payment error: $latestPaymentError")
+      appendLine("Pending redemption: $pendingRedemption")
+      appendLine(
+        "Server subscription: " + when {
+          !serverCheckComplete -> "not checked"
+          serverSubscriptionActive == true -> "active"
+          else -> "inactive"
+        }
+      )
+      appendLine("Server status: $serverSubscriptionStatus")
+      appendLine("Server renewal epoch seconds: ${serverRenewalEpochSeconds ?: "unknown"}")
+      appendLine("Server will cancel: ${serverWillCancel ?: "unknown"}")
+    }.trimEnd()
+  }
+
+  companion object {
+    fun initial(): BackupSubscriptionDiagnosticsState {
+      return BackupSubscriptionDiagnosticsState(
+        backupsEnabled = false,
+        backupTier = "None",
+        paidTier = false,
+        playBillingSupported = false,
+        postRegistrationRelinkEnabled = false,
+        hasSubscriber = false,
+        subscriptionType = "None",
+        hasPurchaseToken = false,
+        lastKeepAliveLaunchMillis = 0,
+        lastCheckInMillis = 0,
+        lastBackupMillis = 0,
+        subscriptionMismatch = false,
+        latestPaymentState = "None",
+        latestRedemptionStage = "None",
+        latestPaymentError = "None",
+        pendingRedemption = false,
+        serverCheckComplete = false,
+        serverSubscriptionActive = null,
+        serverSubscriptionStatus = "Not checked",
+        serverRenewalEpochSeconds = null,
+        serverWillCancel = null,
+        actionInProgress = null,
+        actionMessage = null
+      )
+    }
+  }
+}
