+/*
+ * Copyright 2026 Vesper contributors
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.util
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class VesperBackupSubscriptionPolicyTest {
+
+  @Test
+  fun `post-registration relink is disabled without Play Billing support`() {
+    assertFalse(
+      VesperBackupSubscriptionPolicy.shouldEnqueuePostRegistrationRedemption(
+        supportsGooglePlayBilling = false
+      )
+    )
+  }
+
+  @Test
+  fun `post-registration relink remains available when Play Billing is supported`() {
+    assertTrue(
+      VesperBackupSubscriptionPolicy.shouldEnqueuePostRegistrationRedemption(
+        supportsGooglePlayBilling = true
+      )
+    )
+  }
+}
