+/*
+ * Copyright 2026 Vesper contributors
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.components.settings.app.internal.backup.subscription
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import org.signal.donations.InAppPaymentType
+import org.signal.network.NetworkResult
+import org.thoughtcrime.securesms.backup.v2.BackupRepository
+import org.thoughtcrime.securesms.backup.v2.MessageBackupTier
+import org.thoughtcrime.securesms.components.settings.app.subscription.InAppPaymentsRepository
+import org.thoughtcrime.securesms.components.settings.app.subscription.RecurringInAppPaymentRepository
+import org.thoughtcrime.securesms.database.SignalDatabase
+import org.thoughtcrime.securesms.database.model.InAppPaymentSubscriberRecord
+import org.thoughtcrime.securesms.jobs.BackupMessagesJob
+import org.thoughtcrime.securesms.jobs.BackupRefreshJob
+import org.thoughtcrime.securesms.jobs.InAppPaymentKeepAliveJob
+import org.thoughtcrime.securesms.keyvalue.SignalStore
+import org.thoughtcrime.securesms.util.Environment
+import org.thoughtcrime.securesms.util.VesperBackupSubscriptionPolicy
+import org.whispersystems.signalservice.api.storage.IAPSubscriptionId
+import org.whispersystems.signalservice.api.subscriptions.ActiveSubscription
+import kotlin.time.Duration.Companion.milliseconds
+
+class BackupSubscriptionDiagnosticsViewModel : ViewModel() {
+
+  private val mutableState = MutableStateFlow(BackupSubscriptionDiagnosticsState.initial())
+  val state = mutableState.asStateFlow()
+
+  init {
+    refresh(checkServer = true)
+  }
+
+  fun refresh(checkServer: Boolean = true) {
+    viewModelScope.launch(Dispatchers.IO) {
+      mutableState.update { readLocalState(it, serverCheckComplete = if (checkServer) false else it.serverCheckComplete) }
+      if (checkServer) {
+        checkServerSubscription()
+      }
+    }
+  }
+
+  fun runKeepAlive() {
+    runAction("Backup keepalive") {
+      InAppPaymentKeepAliveJob.enqueueBackupAndTrackTime(System.currentTimeMillis().milliseconds)
+      "Backup-only keepalive queued."
+    }
+  }
+
+  fun runBackupCheckIn() {
+    runAction("Backup check-in") {
+      if (BackupRefreshJob.enqueueNow()) {
+        "Backup check-in queued."
+      } else {
+        "Backup check-in was not queued because backups are disabled or the account is not registered."
+      }
+    }
+  }
+
+  fun runBackupNow() {
+    runAction("Backup upload") {
+      BackupMessagesJob.enqueue()
+      "Backup upload queued."
+    }
+  }
+
+  fun refreshBackupCredentials() {
+    runAction("Credential refresh") {
+      BackupRepository.resetInitializedStateAndAuthCredentials()
+      val tier = BackupRepository.getBackupTierWithoutDowngrade().getOrNull()
+      if (tier != null) {
+        SignalStore.backup.backupTier = tier
+        "Backup credentials refreshed. Server tier: $tier."
+      } else {
+        "Backup credential refresh failed. Check the debug log."
+      }
+    }
+  }
+
+  private fun runAction(name: String, block: () -> String) {
+    if (mutableState.value.actionInProgress != null) {
+      return
+    }
+
+    mutableState.update { it.copy(actionInProgress = name, actionMessage = null) }
+    viewModelScope.launch(Dispatchers.IO) {
+      val message = try {
+        block()
+      } catch (e: CancellationException) {
+        throw e
+      } catch (e: Exception) {
+        "$name failed: ${e::class.simpleName}"
+      }
+
+      mutableState.update {
+        readLocalState(it, serverCheckComplete = it.serverCheckComplete)
+          .copy(actionInProgress = null, actionMessage = message)
+      }
+    }
+  }
+
+  private fun checkServerSubscription() {
+    val result = RecurringInAppPaymentRepository.getActiveSubscriptionSync(InAppPaymentSubscriberRecord.Type.BACKUP)
+    mutableState.update { current ->
+      when (result) {
+        is NetworkResult.Success -> {
+          val response = result.result
+          val subscription = response.activeSubscription
+          current.copy(
+            serverCheckComplete = true,
+            serverSubscriptionActive = response.isActive,
+            serverSubscriptionStatus = subscription?.let { ActiveSubscription.Status.getStatus(it.status).name } ?: "None",
+            serverRenewalEpochSeconds = subscription?.endOfCurrentPeriod,
+            serverWillCancel = response.willCancelAtPeriodEnd(),
+            actionMessage = current.actionMessage
+          )
+        }
+        else -> current.copy(
+          serverCheckComplete = true,
+          serverSubscriptionActive = null,
+          serverSubscriptionStatus = "Check failed: ${result::class.simpleName}",
+          serverRenewalEpochSeconds = null,
+          serverWillCancel = null
+        )
+      }
+    }
+  }
+
+  private fun readLocalState(
+    current: BackupSubscriptionDiagnosticsState,
+    serverCheckComplete: Boolean
+  ): BackupSubscriptionDiagnosticsState {
+    val subscriber = InAppPaymentsRepository.getSubscriber(InAppPaymentSubscriberRecord.Type.BACKUP)
+    val payment = SignalDatabase.inAppPayments.getLatestInAppPaymentByType(InAppPaymentType.RECURRING_BACKUP)
+    val supportsPlayBilling = Environment.Backups.supportsGooglePlayBilling()
+
+    val subscriptionType = when (subscriber?.iapSubscriptionId) {
+      is IAPSubscriptionId.GooglePlayBillingPurchaseToken -> "Google Play Billing"
+      is IAPSubscriptionId.AppleIAPOriginalTransactionId -> "Apple IAP"
+      null -> if (subscriber == null) "None" else "Unknown"
+    }
+
+    return current.copy(
+      backupsEnabled = SignalStore.backup.areBackupsEnabled,
+      backupTier = SignalStore.backup.backupTier?.name ?: "None",
+      paidTier = SignalStore.backup.backupTier == MessageBackupTier.PAID,
+      playBillingSupported = supportsPlayBilling,
+      postRegistrationRelinkEnabled = VesperBackupSubscriptionPolicy.shouldEnqueuePostRegistrationRedemption(supportsPlayBilling),
+      hasSubscriber = subscriber != null,
+      subscriptionType = subscriptionType,
