+package org.thoughtcrime.securesms.util
+
+import android.content.Context
+import androidx.preference.PreferenceManager
+
+/** Retains the preference used by Vesper before Signal removed TextSecurePreferences. */
+object VesperLogPreferences {
+  private const val LOG_ENABLED = "pref_log_enabled"
+
+  @JvmStatic
+  fun setLogEnabled(context: Context, enabled: Boolean) {
+    PreferenceManager.getDefaultSharedPreferences(context).edit().putBoolean(LOG_ENABLED, enabled).apply()
+  }
+
+  @JvmStatic
+  fun isLogEnabled(context: Context): Boolean {
+    return PreferenceManager.getDefaultSharedPreferences(context).getBoolean(LOG_ENABLED, false)
+  }
+}
