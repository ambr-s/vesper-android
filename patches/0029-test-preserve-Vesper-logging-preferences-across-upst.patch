+package org.thoughtcrime.securesms.util
+
+import android.app.Application
+import androidx.preference.PreferenceManager
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(application = Application::class, sdk = [34])
+class VesperLogPreferencesTest {
+  private val application: Application get() = RuntimeEnvironment.getApplication()
+
+  @Before
+  fun clearPreferences() {
+    PreferenceManager.getDefaultSharedPreferences(application).edit().clear().commit()
+  }
+
+  @Test
+  fun `logging remains disabled by default`() {
+    assertFalse(VesperLogPreferences.isLogEnabled(application))
+  }
+
+  @Test
+  fun `existing logging preference survives the upstream preferences removal`() {
+    val preferences = PreferenceManager.getDefaultSharedPreferences(application)
+    preferences.edit().putBoolean("pref_log_enabled", true).commit()
+    assertTrue(VesperLogPreferences.isLogEnabled(application))
+    VesperLogPreferences.setLogEnabled(application, false)
+    assertFalse(preferences.getBoolean("pref_log_enabled", true))
+    VesperLogPreferences.setLogEnabled(application, true)
+    assertTrue(preferences.getBoolean("pref_log_enabled", false))
+  }
+}
