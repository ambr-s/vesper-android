From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: amber <amber@flourish.ch>
Date: Wed, 30 Sep 2026 06:10:26 +0000
Subject: [PATCH 28/28] test: isolate shared Vesper account configuration

Reset process-wide configuration after each test as well as before it. Otherwise the cached-override test can leave android.internalUser forced true for the upstream static-value checks. Exercise the actual JUnit lifecycle to make the regression independent of test ordering.

Signed-off-by: amber <amber@flourish.ch>
---
 .../securesms/util/VesperConfigTest.kt            | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/app/src/test/java/org/thoughtcrime/securesms/util/VesperConfigTest.kt b/app/src/test/java/org/thoughtcrime/securesms/util/VesperConfigTest.kt
index e5ca6ea..ec6b691 100644
--- a/app/src/test/java/org/thoughtcrime/securesms/util/VesperConfigTest.kt
+++ b/app/src/test/java/org/thoughtcrime/securesms/util/VesperConfigTest.kt
@@ -5,6 +5,7 @@
 
 package org.thoughtcrime.securesms.util
 
+import org.junit.After
 import org.junit.Assert.assertEquals
 import org.junit.Assert.assertFalse
 import org.junit.Assert.assertThrows
@@ -20,10 +21,22 @@ class VesperConfigTest {
   private val aciHash = "11e594f481958c10e3015d0bf0447a22f068a8a647f475df15ce2c7ab4b8f3f1"
 
   @Before
-  fun setUp() {
+  @After
+  fun resetState() {
     VesperConfig.resetForTest()
   }
 
+  @Test
+  fun `test lifecycle clears cached overrides after each test`() {
+    // Run the real JUnit lifecycle so a missing @After cannot pass merely
+    // because the next test's @Before happens to clear this process-wide state.
+    val result = org.junit.runner.JUnitCore().run(
+      org.junit.runner.Request.method(VesperConfigTest::class.java, "applies cached overrides without mutating the base config")
+    )
+    assertTrue(result.failures.toString(), result.wasSuccessful())
+    assertEquals(false, VesperConfig.valueWithOverride("android.internalUser", false))
+  }
+
   @Test
   fun `hashes the canonical lowercase ACI`() {
     assertEquals(aciHash, hashVesperAci(aci))
