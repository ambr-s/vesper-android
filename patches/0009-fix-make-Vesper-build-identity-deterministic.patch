+data class VesperBuildMetadata(
+  val timestampMilliseconds: String,
+  val sequence: String,
+  val id: String
+)
+
+fun getVesperBuildMetadata(): VesperBuildMetadata {
+  val patchsetRoot = rootProject.projectDir.parentFile
+  val isVesperPatchset = patchsetRoot.resolve("upstream.pin").isFile &&
+    patchsetRoot.resolve("patches").isDirectory &&
+    patchsetRoot.resolve(".git").exists()
+
+  if (!isVesperPatchset) {
+    return VesperBuildMetadata(
+      timestampMilliseconds = getLastCommitTimestamp(),
+      sequence = "0",
+      id = getGitHash()
+    )
+  }
+
+  fun patchsetGit(vararg arguments: String): String {
+    return providers.exec {
+      workingDir(patchsetRoot)
+      commandLine("git", *arguments)
+    }.standardOutput.asText.get().trim()
+  }
+
+  return VesperBuildMetadata(
+    timestampMilliseconds = patchsetGit("show", "-s", "--format=%ct", "HEAD") + "000",
+    sequence = patchsetGit("rev-list", "--first-parent", "--count", "HEAD"),
+    id = patchsetGit("rev-parse", "HEAD")
+  )
+}
+
 fun getGitHash(): String {
   return providers.exec {
     commandLine("git", "rev-parse", "HEAD")
