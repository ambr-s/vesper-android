 class ApkUpdateJobTest {
 
   @Test
-  fun `newer version code is an update regardless of build timestamp`() {
-    assertTrue(shouldUpdate(100, 2_000, 101, 1_000))
+  fun `newer version code is an update regardless of build metadata`() {
+    assertTrue(shouldUpdate(100, 10, 2_000, 101, 1, 1_000))
   }
 
   @Test
-  fun `older version code is not an update regardless of build timestamp`() {
-    assertFalse(shouldUpdate(101, 1_000, 100, 2_000))
+  fun `older version code is not an update regardless of build metadata`() {
+    assertFalse(shouldUpdate(101, 1, 1_000, 100, 10, 2_000))
   }
 
   @Test
-  fun `same version code with newer build timestamp is an update`() {
-    assertTrue(shouldUpdate(100, 1_000, 100, 2_000))
+  fun `same version code with newer build sequence is an update`() {
+    assertTrue(shouldUpdate(100, 10, 2_000, 100, 11, 1_000))
   }
 
   @Test
-  fun `same version code with same or older build timestamp is not an update`() {
-    assertFalse(shouldUpdate(100, 2_000, 100, 2_000))
-    assertFalse(shouldUpdate(100, 2_000, 100, 1_000))
+  fun `same version code with same or older build sequence is not an update`() {
+    assertFalse(shouldUpdate(100, 10, 1_000, 100, 10, 2_000))
+    assertFalse(shouldUpdate(100, 10, 1_000, 100, 9, 2_000))
   }
 
   @Test
-  fun `same version code without build timestamp is backward-compatible`() {
-    assertFalse(shouldUpdate(100, 1_000, 100, null))
+  fun `legacy timestamp is used when the manifest has no build sequence`() {
+    assertTrue(shouldUpdate(100, 10, 1_000, 100, null, 2_000))
+    assertFalse(shouldUpdate(100, 10, 2_000, 100, null, 2_000))
+    assertFalse(shouldUpdate(100, 10, 2_000, 100, null, null))
+  }
+
+  @Test
+  fun `standalone builds without a sequence use the legacy timestamp`() {
+    assertTrue(shouldUpdate(100, 0, 1_000, 100, 10, 2_000))
+    assertFalse(shouldUpdate(100, 0, 2_000, 100, 10, 1_000))
+  }
+
+  @Test
+  fun `same sequence with a different build ID is a collision`() {
+    assertTrue(hasBuildIdentityCollision(100, 10, "installed", 100, 10, "available"))
+    assertFalse(hasBuildIdentityCollision(100, 10, "installed", 100, 11, "available"))
+    assertFalse(hasBuildIdentityCollision(100, 10, "installed", 101, 10, "available"))
+    assertFalse(hasBuildIdentityCollision(100, 0, "installed", 100, 0, "available"))
+    assertFalse(hasBuildIdentityCollision(100, 10, "installed", 100, 10, null))
   }
