       val digest: ByteArray = Hex.fromStringCondensed(updateDescriptor.digest)
       val downloadStatus: DownloadStatus = getDownloadStatus(updateDescriptor.url, digest)
 
@@ -97,7 +119,7 @@ class ApkUpdateJob private constructor(parameters: Parameters) : BaseJob(paramet
         handleDownloadStart(updateDescriptor.url, updateDescriptor.versionName, digest, updateDescriptor.uploadTimestamp ?: 0)
       }
     } else {
-      Log.d(TAG, "The installed build is current. Installed: (versionCode: ${getCurrentAppVersionCode()}, buildTime: ${BuildConfig.BUILD_TIMESTAMP}), available: (versionCode: ${updateDescriptor.versionCode}, buildTime: ${updateDescriptor.buildTimestamp}, uploadTime: ${updateDescriptor.uploadTimestamp})")
+      Log.d(TAG, "The installed build is current. Installed: (versionCode: $currentVersionCode, buildSequence: ${BuildConfig.VESPER_BUILD_SEQUENCE}, buildId: ${BuildConfig.VESPER_BUILD_ID}, buildTime: ${BuildConfig.BUILD_TIMESTAMP}), available: (versionCode: ${updateDescriptor.versionCode}, buildSequence: ${updateDescriptor.buildSequence}, buildId: ${updateDescriptor.buildId}, buildTime: ${updateDescriptor.buildTimestamp}, uploadTime: ${updateDescriptor.uploadTimestamp})")
     }
 
     SignalStore.apkUpdate.lastSuccessfulCheck = System.currentTimeMillis()
@@ -223,7 +245,13 @@ class ApkUpdateJob private constructor(parameters: Parameters) : BaseJob(paramet
     val uploadTimestamp: Long? = null,
 
     @JsonProperty
-    val buildTimestamp: Long? = null
+    val buildTimestamp: Long? = null,
+
+    @JsonProperty
+    val buildSequence: Long? = null,
+
+    @JsonProperty
+    val buildId: String? = null
   )
 
   private class DownloadStatus(val status: Status, val downloadId: Long) {
@@ -243,14 +271,34 @@ class ApkUpdateJob private constructor(parameters: Parameters) : BaseJob(paramet
 
 internal fun shouldUpdate(
   currentVersionCode: Int,
+  currentBuildSequence: Long,
   currentBuildTimestamp: Long,
   availableVersionCode: Int,
+  availableBuildSequence: Long?,
   availableBuildTimestamp: Long?
 ): Boolean {
-  return availableVersionCode > currentVersionCode ||
-    (
-      availableVersionCode == currentVersionCode &&
-        availableBuildTimestamp != null &&
-        availableBuildTimestamp > currentBuildTimestamp
-      )
+  if (availableVersionCode != currentVersionCode) {
+    return availableVersionCode > currentVersionCode
+  }
+
+  if (currentBuildSequence > 0 && availableBuildSequence != null && availableBuildSequence > 0) {
+    return availableBuildSequence > currentBuildSequence
+  }
+
+  return availableBuildTimestamp != null && availableBuildTimestamp > currentBuildTimestamp
+}
+
+internal fun hasBuildIdentityCollision(
+  currentVersionCode: Int,
+  currentBuildSequence: Long,
+  currentBuildId: String,
+  availableVersionCode: Int,
+  availableBuildSequence: Long?,
+  availableBuildId: String?
+): Boolean {
+  return availableVersionCode == currentVersionCode &&
+    currentBuildSequence > 0 &&
+    availableBuildSequence == currentBuildSequence &&
+    !availableBuildId.isNullOrEmpty() &&
+    availableBuildId != currentBuildId
 }
