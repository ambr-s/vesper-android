diff --git a/app/src/test/java/org/thoughtcrime/securesms/components/settings/app/appearance/AppearanceSettingsViewModelTest.kt b/app/src/test/java/org/thoughtcrime/securesms/components/settings/app/appearance/AppearanceSettingsViewModelTest.kt
index 75d33f5d36..d8a7251365 100644
--- a/app/src/test/java/org/thoughtcrime/securesms/components/settings/app/appearance/AppearanceSettingsViewModelTest.kt
+++ b/app/src/test/java/org/thoughtcrime/securesms/components/settings/app/appearance/AppearanceSettingsViewModelTest.kt
@@ -52,6 +52,11 @@ class AppearanceSettingsViewModelTest {
 
     every { AppearanceSettingsRepository.getLanguage() } returns "zz"
     every { AppearanceSettingsRepository.getTheme() } returns Theme.SYSTEM
+    every { AppearanceSettingsRepository.isDynamicColorsEnabled() } returns true
+    every { AppearanceSettingsRepository.isVesperThemeEnabled() } returns true
+    every { AppearanceSettingsRepository.isDynamicColorsAvailable() } returns false
+    every { AppearanceSettingsRepository.setDynamicColors(any()) } just Runs
+    every { AppearanceSettingsRepository.setVesperTheme(any()) } just Runs
     every { AppearanceSettingsRepository.getMessageFontSize() } returns 16
     every { AppearanceSettingsRepository.isCompactNavigationBar() } returns false
     every { AppearanceSettingsRepository.isSystemThemeAvailable() } returns true
@@ -208,6 +213,42 @@ class AppearanceSettingsViewModelTest {
     assertThat(viewModel.state.value.isCompactNavigationBar).isTrue()
   }
 
+  @Test
+  fun `Vesper theme changes persist both toggle directions without resetting dynamic colors`() = runTest(testDispatcher) {
+    val viewModel = AppearanceSettingsViewModel()
+    for (enabled in listOf(false, true)) {
+      viewModel.onEvent(AppearanceSettingsEvent.VesperThemeChanged(enabled))
+      verify { AppearanceSettingsRepository.setVesperTheme(enabled) }
+      assertThat(viewModel.state.value.vesperTheme).isEqualTo(enabled)
+      assertThat(viewModel.state.value.dynamicColors).isTrue()
+    }
+    verify(exactly = 0) { AppearanceSettingsRepository.setDynamicColors(any()) }
+  }
+
+  @Test
+  fun `dynamic color changes persist both toggle directions without changing the selected theme`() = runTest(testDispatcher) {
+    every { AppearanceSettingsRepository.getTheme() } returns Theme.DARK
+    val viewModel = AppearanceSettingsViewModel()
+    for (enabled in listOf(false, true)) {
+      viewModel.onEvent(AppearanceSettingsEvent.DynamicColorsChanged(enabled))
+      verify { AppearanceSettingsRepository.setDynamicColors(enabled) }
+      assertThat(viewModel.state.value.dynamicColors).isEqualTo(enabled)
+      assertThat(viewModel.state.value.theme).isEqualTo(Theme.DARK)
+    }
+    verify(exactly = 0) { AppearanceSettingsRepository.setTheme(any()) }
+  }
+
+  @Test
+  fun `persisted Vesper preferences are read at startup`() = runTest(testDispatcher) {
+    every { AppearanceSettingsRepository.isDynamicColorsEnabled() } returns false
+    every { AppearanceSettingsRepository.isVesperThemeEnabled() } returns false
+    every { AppearanceSettingsRepository.isDynamicColorsAvailable() } returns true
+    val state = AppearanceSettingsViewModel().state.value
+    assertThat(state.dynamicColors).isFalse()
+    assertThat(state.vesperTheme).isFalse()
+    assertThat(state.isDynamicColorsAvailable).isTrue()
+  }
+
   private fun TestScope.collectActions(actions: Flow<AppearanceSettingsAction>): List<AppearanceSettingsAction> {
     val collected = mutableListOf<AppearanceSettingsAction>()
     backgroundScope.launch { actions.toList(collected) }
