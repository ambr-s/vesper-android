+package org.thoughtcrime.securesms.keyvalue
+
+import android.app.Application
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.RuleChain
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.thoughtcrime.securesms.testutil.MockAppDependenciesRule
+import org.thoughtcrime.securesms.testutil.SignalStoreRule
+
+@RunWith(RobolectricTestRunner::class)
+@Config(application = Application::class, sdk = [34])
+class VesperSettingsValuesTest {
+  @get:Rule
+  val rules: RuleChain = RuleChain.outerRule(MockAppDependenciesRule()).around(SignalStoreRule())
+
+  @Test
+  fun `theme setter preserves an explicit dynamic color opt out`() {
+    val settings = SignalStore.settings
+    assertTrue(settings.isDynamicColorsEnabled)
+    settings.setTheme(SettingsValues.Theme.LIGHT, false)
+    settings.theme = SettingsValues.Theme.DARK
+    assertEquals(SettingsValues.Theme.DARK, settings.theme)
+    assertFalse(settings.isDynamicColorsEnabled)
+    settings.setTheme(SettingsValues.Theme.SYSTEM, true)
+    assertTrue(settings.isDynamicColorsEnabled)
+  }
+
+  @Test
+  fun `Vesper and remote delete controls retain their defaults and stored values`() {
+    val settings = SignalStore.settings
+    assertTrue(settings.isVesperThemeEnabled)
+    assertFalse(settings.isIgnoreRemoteDeleteEnabled)
+    settings.isVesperThemeEnabled = false
+    settings.setIgnoreRemoteDelete(true)
+    assertFalse(settings.isVesperThemeEnabled)
+    assertTrue(settings.isIgnoreRemoteDeleteEnabled)
+  }
+
+  @Test
+  fun `downstream settings retain stable backup keys`() {
+    val keys = SignalStore.settings.getKeysToIncludeInBackup()
+    assertTrue(keys.contains("settings.dynamicColors"))
+    assertTrue(keys.contains("settings.vesperTheme"))
+    assertTrue(keys.contains("settings.ignore.remote.delete"))
+  }
+}
